@{
    ViewData["Title"] = "Password Reset";
}

<div class="auth-shell">
    <div class="ucp-card auth-card">
        <div class="ucp-card-body text-center">
            <h2 class="mb-2">Password reset successful</h2>
            <p class="text-muted-soft">You can now log in with your new password.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-2">Go to Login</a>
        </div>
    </div>
</div>
