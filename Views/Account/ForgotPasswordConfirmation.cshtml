@{
    ViewData["Title"] = "Password Reset";
    var resetLink = TempData["DemoResetLink"]?.ToString();
}

<div class="auth-page">
    <div class="auth-card">

        <div class="text-center mb-4">
            <div class="auth-eyebrow">Account Security</div>

            <h2 class="mb-2">
                Password Reset
            </h2>

            <p class="text-muted-soft">
                Your password reset request has been processed.
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(resetLink))
        {
            <div class="alert alert-info">
                <strong>Demo Mode</strong>

                <p class="mb-2 mt-2">
                    Your password reset link has been generated.
                    Click the button below to reset your password.
                </p>

                <div class="d-grid">
                    <a href="@resetLink"
                       class="btn btn-primary">
                        Reset Password
                    </a>
                </div>
            </div>

            <div class="mt-3">
                <p class="small text-muted-soft mb-1">
                    Reset link:
                </p>

                <div class="border rounded-3 p-2 bg-light"
                     style="word-break: break-all;">
                    <a href="@resetLink">
                        @resetLink
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success text-center">
                <strong>Check your email</strong>

                <p class="mb-0 mt-2">
                    If an account exists with the provided email,
                    password reset instructions have been sent.
                </p>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-primary">
                Back to Login
            </a>
        </div>

    </div>
</div>