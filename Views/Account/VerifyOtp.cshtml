@model UcpCarPool.ViewModels.VerifyOtpViewModel
@{
    var isPasswordReset = string.Equals(Model.Purpose, "PasswordReset", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isPasswordReset ? "Verify OTP" : "Verify Email";
}

<div class="auth-shell">
    <div class="ucp-card auth-card">
        <div class="ucp-card-body">
            <div class="auth-eyebrow">@(isPasswordReset ? "Password recovery" : "One last step")</div>
            <h2 class="mb-1">@(isPasswordReset ? "Verify OTP" : "Verify Your Email")</h2>
            <p class="text-muted-soft">
                @if (isPasswordReset)
                {
                    <span>Enter the 6-digit demo code for <strong>@Model.Email</strong> to continue.</span>
                }
                else
                {
                    <span>We sent a 6-digit code to <strong>@Model.Email</strong></span>
                }
            </p>

            @if (TempData["DemoOtp"] != null)
            {
                <div class="alert alert-info">
                    <strong>Demo mode:</strong> no email service is connected yet, so here's your code directly —
                    <div class="fs-3 fw-bold text-center mt-1" style="letter-spacing: 0.3em;">@TempData["DemoOtp"]</div>
                </div>
            }

            <form asp-controller="Account" asp-action="VerifyOtp" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Purpose" />

                <div class="mb-3">
                    <label asp-for="Code" class="form-label"></label>
                    <input asp-for="Code" class="form-control text-center fs-4" style="letter-spacing:0.3em;"
                           maxlength="6" placeholder="000000" autofocus />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">@(isPasswordReset ? "Verify & Continue" : "Verify")</button>
            </form>

            <form asp-controller="Account" asp-action="ResendOtp" method="post" class="mt-3 text-center">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@Model.Email" />
                <input type="hidden" name="purpose" value="@Model.Purpose" />
                <button type="submit" class="btn btn-link btn-sm">Didn't get a code? Resend</button>
            </form>

            @if (isPasswordReset)
            {
                <p class="text-center text-muted-soft small mt-3 mb-0">
                    <a asp-controller="Account" asp-action="ForgotPassword">Use a different email</a>
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
