@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using UcpCarPool.Models
@using UcpCarPool.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext DbContext
@{
    int unreadCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUserId = UserManager.GetUserId(User);
        if (currentUserId != null)
        {
            unreadCount = await DbContext.Notifications.CountAsync(n => n.UserId == currentUserId && !n.IsRead);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UcpCarPool</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page-shell">

        <header>
            <nav class="navbar navbar-expand-lg ucp-navbar">
                <div class="container">

                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-dot"></span> UcpCarPool
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNav" aria-controls="mainNav"
                            aria-expanded="false" aria-label="Toggle navigation"
                            style="border-color: rgba(255,255,255,0.3);">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>

                            @if (SignInManager.IsSignedIn(User))
                            {
                                @if (User.IsInRole(Roles.Member))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Rides" asp-action="Search">Find a Ride</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Rides" asp-action="Index">My Rides</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Requests" asp-action="MyRequests">My Requests</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Vehicles" asp-action="Index">My Vehicle</a>
                                    </li>
                                }
                                @if (User.IsInRole(Roles.Admin))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
                                    </li>
                                }
                            }
                        </ul>

                        <ul class="navbar-nav align-items-lg-center">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <li class="nav-item me-2">
                                    <a class="nav-link position-relative" asp-controller="Notifications" asp-action="Index">
                                        🔔
                                        @if (unreadCount > 0)
                                        {
                                            <span class="badge rounded-pill bg-danger" style="font-size:0.6rem; vertical-align: top;">@unreadCount</span>
                                        }
                                    </a>
                                </li>
                                <li class="nav-item me-2">
                                    <span class="ucp-user-chip">
                                        @User.Identity!.Name
                                        @if (User.IsInRole(Roles.Admin))
                                        {
                                            <span class="ucp-role-badge">Admin</span>
                                        }
                                    </span>
                                </li>
                                <li class="nav-item">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-light btn-logout btn-sm">Logout</button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-accent btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Get Started</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main class="page-main">
            <div class="container py-4">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @TempData["Info"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>

        <footer class="ucp-footer">
            <div class="container d-flex justify-content-between flex-wrap gap-2">
                <span>&copy; 2026 UcpCarPool — University of Central Punjab</span>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
